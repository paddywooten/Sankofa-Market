# Dependencies
node_modules/
vendor/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Firebase
.firebase/
firebase-debug.log
firestore-debug.log

# Build output is committed on purpose: Firebase serves dist/ directly,
# so a clone can deploy without running the bundler.
build/
*.log

# Environment
.env
.env.local
.env.*.local

# Cache
.cache/
.parcel-cache/

# esbuild sourcemaps (regenerated on build, never deployed)
**/*.map

# Firebase Functions runtime config (contains live secrets)
functions/.runtimeconfig.json
