rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Product images: authenticated users can upload to their own folder
    match /products/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Store profile pictures: admins can upload
    match /store-profiles/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Store logos: admins can upload
    match /store-logos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // User avatars: users can upload to their own folder
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Chat attachments: authenticated users can read/write
    match /chat/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
