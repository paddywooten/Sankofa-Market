{
  "hosting": {
    "site": "sankofa-market",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/node_modules/**",
      ".git/**",
      ".gitignore",
      "**/*.map",
      "**/*.md",
      "docs/**",
      "functions/**",
      "**/.DS_Store",
      "tools-*.mjs",
      "*.sh",
      "tests/**",
      "esbuild.config.js",
      "package.json",
      "package-lock.json",
      "firestore.rules",
      "firestore.rules.patch",
      "storage.rules",
      "firestore.indexes.json",
      "dist/meta.json",
      "js/admin-seed.js",
      "pages/admin/test-users.html",
      "LEGAL_DOCUMENTS_COMPILATION.txt",
      "EMAIL_TEMPLATES.html",
      "FIREBASE_SETUP_GUIDE.html",
      "LEGAL_DOCUMENTS_COMPILATION.html",
      "PROJECT_URLS.txt",
      "Sankofa_Market_Legal_Documents.zip"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://www.google.com https://apis.google.com https://js.paystack.co https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://paystack.com; font-src 'self' https://fonts.gstatic.com https://paystack.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://paystack.com https://*.googleapis.com https://*.cloudfunctions.net https://*.firebaseio.com wss://*.firebaseio.com https://www.google.com https://www.gstatic.com https://js.paystack.co https://api.paystack.co https://api.emailjs.com https://accounts.google.com; frame-src 'self' https://js.paystack.co https://checkout.paystack.com https://www.google.com https://apis.google.com https://accounts.google.com https://*.firebaseapp.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
          }
        ]
      },
      {
        "source": "/manifest.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800, immutable"
          }
        ]
      },
      {
        "source": "/models/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/dist/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/dist/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-XSS-Protection",
            "value": "1; mode=block"
          }
        ]
      },
      {
        "source": "/assetlinks.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/imgProxy",
        "function": {
          "functionId": "imgProxy",
          "region": "us-central1"
        }
      },
      {
        "source": "/help",
        "destination": "/pages/help.html"
      },
      {
        "source": "/seller-guide",
        "destination": "/pages/seller-guide.html"
      },
      {
        "source": "/buyer-guide",
        "destination": "/pages/buyer-guide.html"
      },
      {
        "source": "/about",
        "destination": "/pages/about.html"
      },
      {
        "source": "/contact",
        "destination": "/pages/contact.html"
      },
      {
        "source": "/terms",
        "destination": "/pages/terms.html"
      },
      {
        "source": "/privacy",
        "destination": "/pages/privacy.html"
      },
      {
        "source": "/cookie-policy",
        "destination": "/pages/cookie-policy.html"
      },
      {
        "source": "/refund-policy",
        "destination": "/pages/refund-policy.html"
      },
      {
        "source": "/acceptable-use",
        "destination": "/pages/acceptable-use.html"
      },
      {
        "source": "/prohibited-items",
        "destination": "/pages/prohibited-items.html"
      },
      {
        "source": "/disclaimer",
        "destination": "/pages/disclaimer.html"
      },
      {
        "source": "/dashboard",
        "destination": "/pages/user/dashboard.html"
      },
      {
        "source": "/profile",
        "destination": "/pages/user/profile.html"
      },
      {
        "source": "/orders",
        "destination": "/pages/user/orders.html"
      },
      {
        "source": "/listings",
        "destination": "/pages/user/listings.html"
      },
      {
        "source": "/messages",
        "destination": "/pages/user/messages.html"
      },
      {
        "source": "/wishlist",
        "destination": "/pages/user/wishlist.html"
      },
      {
        "source": "/login",
        "destination": "/pages/auth/login.html"
      },
      {
        "source": "/register",
        "destination": "/pages/auth/register.html"
      },
      {
        "source": "/sm-panel",
        "destination": "/pages/admin/dashboard.html"
      },
      {
        "source": "/sm-panel/",
        "destination": "/pages/admin/dashboard.html"
      },
      {
        "source": "/sm-panel/login",
        "destination": "/pages/admin/login.html"
      },
      {
        "source": "/sm-panel/dashboard",
        "destination": "/pages/admin/dashboard.html"
      },
      {
        "source": "/sm-panel/messages",
        "destination": "/pages/admin/messages.html"
      },
      {
        "source": "/sm-panel/analytics",
        "destination": "/pages/admin/analytics.html"
      },
      {
        "source": "/sm-panel/disputes",
        "destination": "/pages/admin/disputes.html"
      },
      {
        "source": "/sm-panel/user-approvals",
        "destination": "/pages/admin/user-approvals.html"
      },
      {
        "source": "/sm-panel/pages/user/messages.html",
        "destination": "/pages/user/messages.html"
      },
      {
        "source": "/wallet",
        "destination": "/pages/user/wallet.html"
      },
      {
        "source": "/sm-panel/wallet",
        "destination": "/pages/user/wallet.html"
      },
      {
        "source": "/sm-panel/payouts",
        "destination": "/pages/admin/payouts.html"
      },
      {
        "source": "/pages/user/notifications",
        "destination": "/pages/user/notifications.html"
      },
      {
        "source": "/sm-panel/email",
        "destination": "/pages/admin/email.html"
      },
      {
        "source": "/sm-panel/email-setup",
        "destination": "/pages/admin/email-setup.html"
      },
      {
        "source": "/my-store",
        "destination": "/pages/user/my-store.html"
      },
      {
        "source": "/store/**",
        "destination": "/store.html"
      },
      {
        "source": "/shops",
        "destination": "/shops.html"
      },
      {
        "source": "/founding",
        "destination": "/founding.html"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
